{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        noonian/cromulent {:local/root "../cromulent"}
        noonian/bendix {:local/root "../bendix"}}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-m" "orrery.test-runner"]}
  ;; the browser and node builds (shadow-cljs reads this alias); the
  ;; cromulent and bendix test paths carry cromulent.smoke and
  ;; bendix.smoke, the cross-runtime facts (tools.deps warns that an
  ;; external path is deprecated; bendix's test alias relies on the same)
  :cljs {:extra-paths ["../cromulent/test" "../bendix/test"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.3"}
                      no.cjohansen/replicant {:mvn/version "2026.07.1"}
                      org.babashka/sci {:mvn/version "0.15.58"}}}}
 :tasks
 {test {:extra-paths ["test"]
        :main-opts ["-m" "orrery.test-runner"]}}}
